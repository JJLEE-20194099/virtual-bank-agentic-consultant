# =============================================
# Database Configuration
# =============================================
# For Docker: use postgres (container name)
# For local development: use localhost
DATABASE_URL=postgresql://swin:swin@postgres:5432/vbac

# =============================================
# OPENAI API Configuration
# =============================================
# Get from: https://platform.openai.com/api-keys
# Steps:
#   1. Go to https://platform.openai.com/api-keys
#   2. Create New API Key
#   3. Copy and paste here
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# VNSTOCK API (Vietnam Stock Market)
# =============================================
# Get from: https://docs.vnstock.site/
# This is a free API for Vietnamese stock data
# Leave empty if using free tier (no key needed for basic access)
VNSTOCK_API_KEY=

# =============================================
# Oil Prices API
# =============================================
# Get from: https://www.eia.gov/opendata/
# Steps:
#   1. Register at https://www.eia.gov/opendata/register/
#   2. Get your API key from your dashboard
OIL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# Hugging Face API Key
# =============================================
# Get from: https://huggingface.co/settings/tokens
# Used for downloading ML models like Whisper, embeddings
# Steps:
#   1. Go to https://huggingface.co/settings/tokens
#   2. Create New token (type: read)
#   3. Copy token and paste here
HF_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================
# AWS Configuration (for Bedrock AI Agents)
# =============================================
# Get from: https://console.aws.amazon.com/
# Steps to get Access Key:
#   1. Go to IAM Dashboard: https://console.aws.amazon.com/iam/
#   2. Users → Select your user
#   3. Security credentials → Create access key
#   4. Copy Access Key ID and Secret Access Key
AWS_ACCESS_KEY_ID=AKIA5XXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=wJalrXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region where Bedrock is available
# Options: us-east-1, us-west-2, ap-southeast-1, ap-northeast-1
AWS_REGION=ap-southeast-1

# IAM Role ARN for Bedrock agent execution
# Get from: https://console.aws.amazon.com/iam/home#/roles
# Create role with Bedrock permissions and copy ARN
# Format: arn:aws:iam::123456789012:role/BedrockExecutionRole
BEDROCK_ROLE=arn:aws:iam::123456789012:role/BedrockAgentRole

# =============================================
# Bedrock Agent Configuration
# =============================================
# These IDs are created when you set up agents via API
# See SETUP_GUIDE.md for how to create agents

# Market Response Agent - Answers user questions about market
BEDROCK_RESPONSE_MARKET_AGENT_ID=P4RQTQCYVA
BEDROCK_RESPONSE_MARKET_ALIAS_ID=TSTALIASID

# Market Analysis Agent - Analyzes market trends
BEDROCK_ANALYSE_MARKET_AGENT_ID=
BEDROCK_ANALYSE_MARKET_ALIAS_ID=

# Portfolio Analysis Agent - Analyzes stock portfolio
BEDROCK_ANALYSE_STOCK_PORTFOLIO_AGENT_ID=
BEDROCK_ANALYSE_STOCK_PORTFOLIO_ALIAS_ID=

# Portfolio Recommendation Agent - Recommends actions
BEDROCK_RECOMMEND_STOCK_PORTFOLIO_AGENT_ID=
BEDROCK_RECOMMEND_STOCK_PORTFOLIO_ALIAS_ID=

# =============================================
# Database Configuration
# =============================================
# PostgreSQL connection string
DATABASE_URL=postgresql://swin:swin@localhost:5432/vbac

# =============================================
# Redis Configuration
# =============================================
# Redis connection URL for caching
REDIS_URL=redis://localhost:6379/0

# =============================================
# Kafka Configuration (Optional)
# =============================================
# Kafka broker addresses for streaming data
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=vbac-consumer-group

# =============================================
# Frontend/Backend Configuration
# =============================================
# Backend API server URL
API_URL=http://localhost:8080
API_PREFIX=/api/v1

# Frontend port (if running web UI)
FRONTEND_PORT=3000

# =============================================
# Logging Configuration
# =============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================
# Feature Store Configuration (Feast)
# =============================================
# Feast registry location for feature store
FEAST_REGISTRY_PATH=./feature_store/repo/registry.db
FEAST_OFFLINE_STORE=postgresql

# =============================================
# Celery Configuration (Background Tasks)
# =============================================
# Celery broker URL (same as Redis usually)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1 